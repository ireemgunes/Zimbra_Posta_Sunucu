# MailOS Security & Environment Configuration Template
# Copy this file to .env and configure strong, unique secrets for your deployment.

# --- Zimbra Core ---
ZIMBRA_HOSTNAME=mail.mailos.local
ZIMBRA_DOMAIN=mailos.local
ZIMBRA_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ZIMBRA_TIMEZONE=Europe/Istanbul

# --- Security, Authentication & Cryptography ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MAILOS_ADMIN_SECRET=generate_a_random_32_byte_secret_for_production
MAILOS_SESSION_TTL=86400
WEBHOOK_SECRET=generate_a_random_hmac_webhook_secret_here
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost,https://mailos.local

# --- Rate Limiting & Brute-Force Defense ---
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_DURATION_SECONDS=900

# --- Backup Automation & Retention ---
BACKUP_SCHEDULE_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/opt/zimbra/backups

# --- API Host & Port ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Redis Cache & Session ---
REDIS_URL=redis://redis:6379/0

# --- Nginx Reverse Proxy ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
